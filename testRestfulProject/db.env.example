# model_service 的本地数据库配置（示例）
#
# 用法：复制成同目录下的 db.env，填入真实值即可，服务启动时会自动读取；
# 若同名环境变量已存在，则以环境变量为准（便于临时覆盖）。
# 注意：db.env 含明文口令，不要提交到版本库 / 不要外发。

MODEL_DB_DIALECT=mysql
MODEL_DB_HOST=127.0.0.1
MODEL_DB_PORT=3306
MODEL_DB_USER=你的MySQL账号
MODEL_DB_PASSWORD=你的MySQL口令
MODEL_DB_NAME=model_management

# ⚠️ 这里以前还列着 SQL Server 与 SQLite 两套示例，**都已删除，别再照抄**：
#   * SQL Server：代码里的 sqlserver/pyodbc 方言分支早已移除，写 MODEL_DB_DIALECT=sqlserver
#     会让服务在 import 期直接 RuntimeError（见 config.py 的方言校验），起都起不来。
#   * SQLite：曾经有"什么都不配就退回 data/model_management.db"的兜底，现在也没有了——
#     MODEL_DB_DIALECT 只接受 mysql，配不出别的值。
#   也就是说：**这个项目只连 MySQL**，上面六行是唯一的配置方式。
#
# 另有一个可选开关不在这里配（因为它跟数据库无关，用环境变量即可）：
#   MODEL_ALLOW_UNTRUSTED_PICKLE=1  放行对"上传的" .pkl 产物做反序列化，默认关闭。


# ============================================================
#  鉴权配置（登录/令牌/权限）
# ============================================================
# ⚠️ 这一节是"交给工厂使用"之前**必须**处理的部分。不配也能跑（有默认值），
#    但默认值只适合开发机，交付现场前请至少设置 MODEL_SECRET_KEY 和
#    MODEL_BOOTSTRAP_ADMIN_PASSWORD 这两项。

# 令牌签名密钥（**生产环境必配，且要够随机**）。
#   不配的后果：服务每次启动随机生成一个 —— 安全性反而更高，但**重启后所有人都
#   要重新登录**。工厂场景会让人以为是"系统坏了"。
#   配得太简单的后果：拿到源码/配置的人可以自己签一个 admin 令牌出来，鉴权失效。
#   生成方法（PowerShell 里跑一次，把输出粘过来）：
#       python -c "import secrets; print(secrets.token_hex(32))"
MODEL_SECRET_KEY=

# 令牌有效期（小时）。默认 12（约一个班次）。
#   工厂是内网单机，可以放宽到 24 甚至 72 减少重登次数；
#   但别设成很大（比如 8760=一年）——令牌一旦泄露就长期有效。
MODEL_TOKEN_TTL_HOURS=12

# 初始管理员口令。**只在第一次启动、Users 表还是空的时候生效**，
# 用来现算哈希建 admin 账号；建完之后这一项就没人读了，改它不会改密码
# （改密码请登录后在"个人中心"改，或让管理员重置）。
#   ⚠️ 不配的话，服务会建 admin / engineer / operator 三个账号，
#      口令分别是 Admin@2026 / Engineer@2026 / Operator@2026。
#      **这三个是公开的演示口令，交付现场前必须处理掉**（配了下面这项就只会建 admin，
#      或者登录后立刻改密、把另外两个删掉）。
MODEL_BOOTSTRAP_ADMIN_PASSWORD=

# 鉴权总开关。默认开（=不配这项）。设为 1 会**完全关闭**权限检查，
#   任何人都能调训练/发布/删除接口，仅用于本地排查问题。
#   ⚠️ 关掉时 /health 会明确回报 auth.enabled=false，别让它悄悄留在现场机器上。
# MODEL_AUTH_DISABLED=

# 忘记管理员口令时的救急办法（不用这个开关、直接改库更稳妥）：
#   把 MODEL_BOOTSTRAP_ADMIN_PASSWORD 设成新口令，然后清空 Users 表重跑一次服务
#   （会重建账号）。⚠️ 这会把**所有**用户一起清掉，只适合单人环境。


