# 单端口部署（后端托管前端）专用
#
# 用法： npm run build:singleport
#       然后重启后端，浏览器只访问后端端口（默认 8080）即可，
#       不需要再单独开 Vite 开发服务器。
#
# ⚠️ VITE_PUBLIC_PATH 必须是 '/'：
#     这是 vite 的 base 配置，决定 index.html 里引用的资源前缀。
#     写 '/web/' 会变成 <script src="/web/assets/xxx.js">，而后端只托管在 /assets/，
#     结果是首页白屏 + 控制台一堆 404。单端口部署下它就该是根路径。

ENV = 'singleport'

# ⚠️ VITE_API_URL 必须留空字符串 —— 这个值反直觉，改错就是"接口全 404/重复前缀"：
#     接口地址在源码里是【带 /api 前缀写全】的（如 views/system/login/api.ts 的 '/api/login/'），
#     而这个值被当作 axios 的 baseURL（utils/service.ts → getBaseURL()），由 axios 做拼接。
#     axios 的拼接规则会把两个前缀**叠加**，所以：
#         VITE_API_URL=''     → '/api/login/'          ✅ 正确
#         VITE_API_URL='/api' → '/api' + '/api/login/' → '/api/api/login/'  ❌ 404
#         VITE_API_URL='/'    → 同理，也会叠出问题
#     留空时 axios 的 baseURL 为 ''，请求直接打到**当前页面的源**（后端自己），
#     所以用户从 192.168.1.10:8080 打开页面，接口就打到同一个地址：
#     天然同源、不需要 CORS，防火墙也只开一个端口。
#
#     为什么容易改错：开发模式（.env.development）里它是完整主机
#     'http://127.0.0.1:5000'，请求靠跨域打到 5000；切到单端口后这里的直觉是
#     "补上 /api"，但接口字面量已经带了，**补了就重复**。
#
#     变量名必须是 VITE_API_URL（别写成 API_URL），全工程 7 处都在读这个名字。
VITE_API_URL = ''

VITE_PUBLIC_PATH = /

# 按钮权限（读 userInfo.permissions 决定显隐，后端仍会拦截）
VITE_PM_ENABLED = true

# 产物直接输出到前端自己的 dist/，由后端自动探测（见 model_service/web.py）
VITE_DIST_PATH = dist
