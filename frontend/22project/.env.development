# 本地环境
ENV = 'development'

# 本地环境接口地址
VITE_API_URL = 'http://127.0.0.1:5000'

# 前端开发服务器端口
# ⚠️ 必须在这里显式声明：vite.config.ts 的 server.port 读的是 env.VITE_PORT。
#    这个值原先只写在 .env 里，而 .env 被仓库根目录的 .gitignore 排除，
#    克隆下来的人拿不到它 → port 变成 undefined → Vite 回落到默认 5173，
#    于是"按文档打开 http://localhost:8080"必然连不上。
VITE_PORT = 8080

# 是否启用按钮权限
VITE_PM_ENABLED = true
