# 线上环境（本项目 = 单端口：Flask 同时托管前端与接口）
ENV = 'production'

# ⚠️ VITE_API_URL 必须留**空字符串** —— 这个值反直觉，填错就是"接口全 404 / 前缀重复"：
#     接口地址在源码里是【带 /api 前缀写全】的（如 views/system/login/api.ts 的 '/api/login/'、
#     平台页的 '/models'），而这个值被当作 axios 的 baseURL，由 axios 自己拼接：
#         VITE_API_URL=''     → '/api/login/'                                  ✅
#         VITE_API_URL='/api' → '/api' + '/api/login/' → '/api/api/login/'    ❌ 全站 404
#     留空时 baseURL 为空，请求直接打到**当前页面的源**（也就是后端），天然同源、不需要 CORS。
#
#     ⚠️ 这里原先是模板自带的 '/api'，注释写着"docker-compose 部署不需要修改，nginx 容器自动代理了
#        这个地址" —— 那是 django-vue3-admin 模板给 **nginx 反代 Django** 的场景；本项目后端是 Flask、
#        走单端口自托管，没有那层 nginx，所以 `npm run build` 出来的产物接口全 404。
#        `.env.singleport` 里早就写明了同一个坑，这里与它对齐（两者产物等价，只是模式名不同）。
VITE_API_URL = ''

# 资源基准路径：必须是 '/'。写 '/web/' 会变成 /web/assets/…，而后端只托管 /assets/，首页白屏。
VITE_PUBLIC_PATH = /

# 产物直接输出到前端自己的 dist/，由后端自动探测（见 model_service/web.py）
VITE_DIST_PATH = dist

# 是否启用按钮权限
VITE_PM_ENABLED = true
