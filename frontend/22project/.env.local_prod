# 线上环境（本机构建 + Flask 后端自托管）
ENV = 'local_prod'

# 线上环境接口地址（前端与 Flask 同源，走相对路径）
VITE_API_URL = '/'

# 是否启用按钮权限
VITE_PM_ENABLED = true

# ⚠️ 下面两项原先照抄 django-vue3-admin 模板，对本项目**是坏的**：
#     · VITE_DIST_PATH = ../backend/templates/web/ —— 本项目后端是 Flask，
#       仓库里根本没有 backend/ 目录，构建会写到一个本不该存在的地方；
#     · VITE_PUBLIC_PATH = /web/ —— 产物里资源会指向 /web/assets/…，
#       而 Flask 的 web.py 只注册了 /assets/<path>，页面会白屏。
#    现对齐 Flask 的真实托管口径：产物落在 frontend/22project/dist
#    （web.py::_dist_dir() 的第一个候选目录），资源基准路径为 /。
#    与 build:singleport 的唯一区别是模式名；做单端口部署两者都可以。
VITE_PUBLIC_PATH = /
# dist目录
VITE_DIST_PATH = dist
